# ==============================================================================
# TaskFlow - Configurações de Variáveis de Ambiente (Opcional / Supabase)
# ==============================================================================
# Por padrão, o TaskFlow utiliza LocalStorage do navegador sem necessidade de backend.
# Para conectar a um banco de dados Supabase em nuvem, preencha as variáveis abaixo
# e renomeie este arquivo para .env.local ou .env.

# URL do seu projeto no Supabase (exemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave Anônima Pública (Anon Public API Key) fornecida no painel do Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key-here
